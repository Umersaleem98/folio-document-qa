DATABASE_URL=mysql+pymysql://docqa:CHANGE_DATABASE_PASSWORD@127.0.0.1:3306/document_qa?charset=utf8mb4
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=30
STORAGE_DIR=./data
COOKIE_SECURE=false
# Local real AI: install Ollama and pull both model names below.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
# Optional chat-only remote API; leave empty to use AI_PROVIDER for both tasks.
CHAT_PROVIDER=
CHAT_BASE_URL=
CHAT_API_KEY=
LLM_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VERSION=v1
MAX_DISTANCE=0.45
CLEANUP_INTERVAL_SECONDS=60
WORKER_POLL_SECONDS=2
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARACTERS=2000000
